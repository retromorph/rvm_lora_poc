# No secrets in this file. Use an SSH config alias (never check in private keys).
REMOTE_HOST=your-ssh-alias
REMOTE_PROJECT_DIR=/home/your-user/rvm-lora-poc
# For processes running on the GPU server (and via an SSH tunnel):
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
HF_HOME=/home/your-user/.cache/huggingface
TOKENIZERS_PARALLELISM=false
